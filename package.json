{
  "name": "melda-shared",
  "version": "0.7.9",
  "description": "Shared domain models, insight aggregation, experience grading, the AI service interface, the deterministic demo seed, and the REST contract for MELDA.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/tokens": {
      "types": "./src/ui/tokens.ts",
      "react-native": "./src/ui/tokens.ts",
      "default": "./src/ui/tokens.ts"
    },
    "./ui/components": {
      "types": "./src/ui/components.tsx",
      "react-native": "./src/ui/components.tsx",
      "default": "./src/ui/components.tsx"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:insights": "tsx src/domain/insights/insights.check.ts",
    "check:experience": "tsx src/domain/experience.check.ts",
    "check:ui": "tsx src/ui/tokens.check.ts",
    "check:richtext": "tsx src/ui/richTextParse.check.ts",
    "check": "pnpm check:insights && pnpm check:experience && pnpm check:ui && pnpm check:richtext",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "mathjax-full": "^3.2.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "mathjax-full": ">=3.2",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "mathjax-full": {
      "optional": true
    }
  }
}
